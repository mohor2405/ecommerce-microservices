{
  "info": {
    "name": "E-commerce - User Service",
    "description": "User Service API (via API Gateway, port 8080). Run 'Register' or 'Login' first: the token is saved automatically into the {{token}} collection variable and used by every protected request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "addressId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('token', pm.response.json().accessToken); }",
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('password is never returned', () => pm.expect(pm.response.json().user).to.not.have.property('password'));"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Soupik\",\n  \"lastName\": \"Chowdhury\",\n  \"email\": \"soupik@example.com\",\n  \"password\": \"Secret123\",\n  \"phone\": \"9876543210\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().accessToken); }",
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]}
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"soupik@example.com\",\n  \"password\": \"Secret123\"\n}" }
          }
        },
        {
          "name": "Register - validation error (400)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"Doe\",\n  \"email\": \"not-an-email\",\n  \"password\": \"weak\"\n}" }
          }
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "Get my profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/me" }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/me",
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Soupik\",\n  \"lastName\": \"Chowdhury\",\n  \"phone\": \"+919876543210\"\n}" }
          }
        },
        {
          "name": "Change my password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/me/password",
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"Secret123\",\n  \"newPassword\": \"NewSecret456\"\n}" }
          }
        },
        {
          "name": "Get user by id (ADMIN only)",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/1" }
        },
        {
          "name": "Delete my account",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/users/me" }
        }
      ]
    },
    {
      "name": "Addresses",
      "item": [
        {
          "name": "Add address",
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('addressId', pm.response.json().id); }"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/me/addresses",
            "body": { "mode": "raw", "raw": "{\n  \"addressLine1\": \"12 Park Street\",\n  \"addressLine2\": \"Flat 4B\",\n  \"city\": \"Kolkata\",\n  \"state\": \"West Bengal\",\n  \"postalCode\": \"700016\",\n  \"country\": \"India\",\n  \"defaultAddress\": true\n}" }
          }
        },
        {
          "name": "Get all my addresses",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/me/addresses" }
        },
        {
          "name": "Get one address",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/me/addresses/{{addressId}}" }
        },
        {
          "name": "Update address",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/users/me/addresses/{{addressId}}",
            "body": { "mode": "raw", "raw": "{\n  \"addressLine1\": \"45 Salt Lake Sector V\",\n  \"addressLine2\": null,\n  \"city\": \"Kolkata\",\n  \"state\": \"West Bengal\",\n  \"postalCode\": \"700091\",\n  \"country\": \"India\",\n  \"defaultAddress\": true\n}" }
          }
        },
        {
          "name": "Delete address",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/users/me/addresses/{{addressId}}" }
        }
      ]
    }
  ]
}
